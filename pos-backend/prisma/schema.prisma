generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum PaymentMode {
  CASH
  UPI
  CARD
}

// One row per login. ADMIN rows = one retail shop (tenant).
model User {
  id           Int      @id @default(autoincrement())
  role         Role     @default(ADMIN)
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)

  // business details (filled by Super Admin when creating an Admin)
  businessName String?
  ownerName    String?
  phone        String?
  address      String?
  gstin        String?
  logoUrl      String?  @db.MediumText // small base64 data URL (resized client-side)
  receiptFooter String?
  paperSize    String   @default("80mm") // 58mm | 80mm | A4

  invoiceSeq   Int      @default(0) // per-shop invoice counter
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories    Category[]
  products      Product[]
  customers     Customer[]
  invoices      Invoice[]
  stockMoves    StockMovement[]
  activityLogs  ActivityLog[]
}

model Category {
  id       Int       @id @default(autoincrement())
  adminId  Int
  admin    User      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  name     String
  products Product[]

  @@unique([adminId, name])
}

model Product {
  id          Int      @id @default(autoincrement())
  adminId     Int
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  barcode     String?
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2) // % GST
  stock       Int      @default(0)
  lowStockAt  Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  items       InvoiceItem[]
  moves       StockMovement[]

  @@unique([adminId, barcode])
  @@index([adminId, name])
}

model Customer {
  id       Int       @id @default(autoincrement())
  adminId  Int
  admin    User      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  name     String
  phone    String?
  email    String?
  invoices Invoice[]

  @@index([adminId, phone])
}

model Invoice {
  id          Int         @id @default(autoincrement())
  adminId     Int
  admin       User        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  invoiceNo   Int         // unique per admin, not global
  customerId  Int?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @default(CASH)
  createdAt   DateTime    @default(now())

  items       InvoiceItem[]

  @@unique([adminId, invoiceNo])
  @@index([adminId, createdAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String  // snapshot at time of sale
  price     Decimal @db.Decimal(10, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  qty       Int
  lineTotal Decimal @db.Decimal(12, 2)
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  change    Int      // +restock, -sale
  reason    String   // SALE | RESTOCK | ADJUSTMENT
  createdAt DateTime @default(now())

  @@index([adminId, productId])
}

// What Super Admin monitors
model ActivityLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String   // LOGIN, INVOICE_CREATED, PRODUCT_UPDATED ...
  entity    String?
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}
